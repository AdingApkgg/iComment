# 本地开发用；复制成 .env 后由 shell 载入（cargo run 不会自动读）
IC_DATABASE_URL=postgres://icomment:icomment@127.0.0.1:25493/icomment
IC_REDIS_URL=redis://127.0.0.1:26493
IC_PUBLIC_BASE_URL=http://127.0.0.1:8080
IC_SESSION_SECRET=dev-only-change-me
# 本地验收要抓 127.0.0.1 时打开
IC_VERIFY_PRIVATE=1
# 附图存储（内容寻址）：填 filer 地址走 SeaweedFS；两项都空则只存内存，重启即丢
IC_SEAWEED_FILER_URL=
IC_UPLOAD_DIR=
