# 必填
IC_DOMAIN=comment.example.com
POSTGRES_USER=icomment
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=icomment
# openssl rand -hex 32
IC_SESSION_SECRET=
# 想启用人机验证时填（Cloudflare Turnstile）
IC_TURNSTILE_SECRET=
IC_TURNSTILE_SITE_KEY=
# Akismet 兜底（可选）：只填 key 就会生效
IC_AKISMET_KEY=
# 登录：生产只走 OAuth，回调地址是 https://<域名>/auth/{google,github}/callback
IC_GOOGLE_CLIENT_ID=
IC_GOOGLE_CLIENT_SECRET=
IC_GITHUB_CLIENT_ID=
IC_GITHUB_CLIENT_SECRET=
# 邮箱直登（任意邮箱都能进，仅限内网试跑；prod 默认关）
IC_EMAIL_LOGIN=0
# 建站前的域名归属校验（prod 默认开，设 0 会拒绝启动）
IC_CLAIM_VERIFY=1

# 宿主 80/443 被占用时改这里，或删掉 compose 里 caddy 的 ports 自己接反代
IC_HTTP_PORT=80
IC_HTTPS_PORT=443
